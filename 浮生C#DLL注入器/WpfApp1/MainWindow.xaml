<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="DLL Injector" Height="240" Width="420"
        ResizeMode="CanMinimize"
        Background="#FF2D2D30"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <!-- 定义资源，如颜色和样式，便于统一修改 -->
    <Window.Resources>
        <!-- 主题颜色 -->
        <SolidColorBrush x:Key="BackgroundColor" Color="#FF2D2D30"/>
        <SolidColorBrush x:Key="ForegroundColor" Color="White"/>
        <SolidColorBrush x:Key="ControlBackgroundColor" Color="#FF3C3C3C"/>
        <SolidColorBrush x:Key="BorderColor" Color="#FF555555"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF0078D4"/>
        <!-- Windows 11 蓝 -->
        <SolidColorBrush x:Key="AccentHoverColor" Color="#FF106EBE"/>
        <SolidColorBrush x:Key="TipTextColor" Color="#FF9A9A9A"/>

        <!-- 提示文本样式 -->
        <Style TargetType="TextBlock" x:Key="TipTextStyle">
            <Setter Property="Foreground" Value="{StaticResource TipTextColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="10,2"/>
        </Style>
    </Window.Resources>

    <!-- 主容器，使用统一的内边距 -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- DLL 路径输入框 -->
        <Border Grid.Row="0"
                Background="{StaticResource ControlBackgroundColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="5,0">
            <TextBox x:Name="FilePathTextBox"
                     Text="*.dll (双击我选择DLL路径)"
                     VerticalAlignment="Center"
                     Foreground="White"
                     FontSize="14"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="True"
                     MouseDoubleClick="TextBox_MouseDoubleClick" />
        </Border>

        <!-- DLL 路径提示 -->
        <TextBlock Grid.Row="1"
                   Style="{StaticResource TipTextStyle}"
                   Text="*Tip: 双击可选择DLL路径或单击编辑框输入"/>

        <!-- 进程名输入框 -->
        <Border Grid.Row="3"
                Background="{StaticResource ControlBackgroundColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="5,0">
            <TextBox x:Name="InjectedGameName"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Foreground="White"
                     Background="Transparent"
                     BorderThickness="0"/>
        </Border>

        <!-- 进程名提示 -->
        <TextBlock Grid.Row="4"
                   Style="{StaticResource TipTextStyle}"
                   Text="*Tip: 下面输入进程名称 (*.exe)"/>

        <!-- Inject 按钮 -->
        <Border Grid.Row="6"
                Background="{StaticResource AccentColor}"
                CornerRadius="5"
                Padding="5"
                Cursor="Hand">
            <Button x:Name="InjectButton"
                    FontSize="22"
                    FontFamily="Arial"
                FontWeight="Bold"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="White"
                    PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" Height="45" Content="DLL Inject" />
                <!-- 为 Border 添加交互效果 -->
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- 鼠标悬停时颜色变亮 -->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverColor}"/>
                            </Trigger>
                            <!-- 鼠标按下时颜色变暗 -->
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="Background" Value="#FF0E5A9A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
        </Border>

    </Grid>
</Window>
