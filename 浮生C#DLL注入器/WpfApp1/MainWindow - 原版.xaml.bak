<Window x:Name="window" x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="DLL-Injector" Height="210" Width="400"
        ResizeMode="CanMinimize">
    <!-- 1. 在Grid上启用拖放并添加事件处理 -->
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="200*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilePathTextBox" HorizontalAlignment="Center" Margin="0,10,0,0"  Text="*.dll(双击我选择DLL路径)" VerticalAlignment="Top"  Width="380" Height="30" Grid.Column="1" FontSize="20"  MouseDoubleClick="TextBox_MouseDoubleClick" IsReadOnly="False"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="10,45,0,0" TextWrapping="Wrap" Text="*Tip:双击可选择DLL路径或单击编辑框输入" VerticalAlignment="Top" Height="16" Width="235"  Foreground="Gray"/>
        <TextBox x:Name="InjectedGameName" Grid.Column="1" HorizontalAlignment="Center" Margin="0,66,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  Width="380" Height="30" FontSize="20" />
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="10,101,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="16" Width="235"  Foreground="Gray"><Run Text="*Tip:"/><Run Language="zh-cn" Text="下面输入进程名称(*.exe)"/></TextBlock>
        <Button Grid.Column="1" Content="Inject DLL" HorizontalAlignment="Center" Margin="0,122,0,0" VerticalAlignment="Top" Height="45" Width="379" FontSize="36" FontFamily="Bahnschrift SemiBold SemiCondensed" PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
    </Grid>
</Window>
